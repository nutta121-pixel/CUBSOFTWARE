# =============================================
# CUBSOFTWARE SERVER — Combined Environment
# Copy to .env and fill in all values.
# This single file configures all apps.
# =============================================

# ── Shared ────────────────────────────────────────────────────
OWNER_IDS=378501056008683530        # Comma-separated Discord user IDs of bot owners
BOT_API_KEY=                        # Shared secret between website and all bots

# ── Flask (Website) ───────────────────────────────────────────
FLASK_SECRET_KEY=                   # Long random string — python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=                      # Secret for admin-only API endpoints
DEV_MODE=0                          # Set to 1 to enable dev mode (skips auth etc.)
CUBSOFTWARE_DATA_DIR=/var/cubsoftware-data
KERAPLAST_ADMIN_PASSWORD=
BMAC_TOKEN=
LINKS_DISCORD_WEBHOOK=
CUBASSIST_ADMIN_KEY=

# ── Discord OAuth (cubsoftware.site) ──────────────────────────
DISCORD_CLIENT_ID=1412661083759579303
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cubsoftware.site/dashboard/callback
CUB_LOGIN_DISCORD_REDIRECT=https://cubsoftware.site/login/discord/callback
BOT_DASHBOARD_REDIRECT_URI=https://cubsoftware.site/bot-dashboard/auth/callback
BAN_APPEAL_REDIRECT_URI=https://cubsoftware.site/ban-appeal/auth/callback
AFFILIATE_REDIRECT_URI=https://cubsoftware.site/affiliate/auth/callback

# ── Twitch (shared: website + cub-protector) ──────────────────
TWITCH_CLIENT_ID=9n9yjc79p44kpsluv81kvvh6h9bxvu
TWITCH_CLIENT_SECRET=
CUB_LOGIN_TWITCH_REDIRECT=https://cubsoftware.site/login/twitch/callback

# ── CubReactive ───────────────────────────────────────────────
CUBREACTIVE_REDIRECT_URI=https://cubsoftware.site/apps/cubreactive/auth/callback
CUBREACTIVE_RPC_REDIRECT_URI=https://cubsoftware.site/apps/cubreactive/auth/rpc/callback
CUBREACTIVE_WS_URL=wss://cubsoftware.site/cubreactive-ws
CUBREACTIVE_WS_PORT=3848

# ── Cub Protector Bot ─────────────────────────────────────────
CUB_PROTECTOR_TOKEN=                # Bot token from Discord Developer Portal
CUB_PROTECTOR_CLIENT_ID=            # Bot application CLIENT_ID
CUB_PROTECTOR_REDIRECT_URI=https://cubsoftware.site/cub-protector/auth/callback
CUB_PROTECTOR_ADMIN_GUILD_ID=       # Guild ID where admin commands are restricted
CUB_PROTECTOR_DEV_GUILD_ID=         # Guild ID for dev/test slash command registration
CUB_PROTECTOR_TERMINAL_CHANNEL_ID=  # Channel for bot terminal output
CUB_PROTECTOR_LINKS_LOG_CHANNEL_ID= # Channel to log detected links
LOG_SERVER_PORT=3847                # Internal log server port (must match on both sides)

# ── CleanMe Bot ───────────────────────────────────────────────
CLEANME_BOT_TOKEN=
CLEANME_BOT_CLIENT_ID=
CLEANME_REDIRECT_URI=https://cubsoftware.site/cleanme/auth/callback
CLEANME_TERMINAL_CHANNEL_ID=1466190746401902855

# ── QuestCord Bot ─────────────────────────────────────────────
QUESTCORD_TOKEN=                    # QuestCord bot token
QUESTCORD_CLIENT_ID=                # QuestCord bot CLIENT_ID
QUESTCORD_CLIENT_SECRET=            # QuestCord bot CLIENT_SECRET
QUESTCORD_SUPPORT_SERVER_ID=1284593395188367502
QUESTCORD_TERMINAL_CHANNEL_ID=1466190431485427856
QUESTCORD_SESSION_SECRET=           # Random string — node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Cloudflare DDNS ───────────────────────────────────────────
CF_API_TOKEN=                       # Cloudflare API token with "Edit zone DNS" permission
ZONE_ID_CUBSOFTWARE=                # Cloudflare Zone ID for cubsoftware.site
ZONE_ID_QUESTCORD=                  # Cloudflare Zone ID for questcord.fun

# ── AI / CubAI (via Cub Protector) ───────────────────────────
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
CUBAI_TRIGGER=cub
WHISPER_MODEL=base
