# Copy this file to .env.secrets and fill in the real values.
# .env.secrets is gitignored — it will NEVER be committed or overwritten by git pull.
#
# On the server:
#   cp .env.secrets.example .env.secrets
#   nano .env.secrets          # fill in real values
#   pm2 restart all            # pick up the new secrets

# Website / Overlays (cubsoftware-website Flask app)
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_SECRET=
CLEANME_BOT_API_KEY=

# CubAssist Twitch bot
# CUBASSIST_ADMIN_KEY is the secret used to access /cubassist/admin/setup and /cubassist/admin/refresh-token
# After the initial /admin/setup OAuth flow, the bot auto-refreshes its own token on every reconnect.
# You should NOT need to re-run /admin/setup unless you fully revoke the bot's Twitch access.
CUBASSIST_ADMIN_KEY=
