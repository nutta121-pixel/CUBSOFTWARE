# ── CUB SOFTWARE Auth Tester ──────────────────────────────────────────────────

# Only this one line is required in your root .env:
INTERNAL_TEST_SECRET=CUBSOFTWARE_KEY_<generate with: node -e "console.log('CUBSOFTWARE_KEY_'+require('crypto').randomBytes(32).toString('hex'))">

# ── Everything below is optional — defaults are already set in ecosystem.config.js ──

# Set to false to temporarily disable the tester (default: true)
# AUTH_TESTER_ENABLED=true

# App base URLs (already hardcoded in ecosystem.config.js)
# CUBSOFTWARE_URL=https://cubsoftware.site
# QUESTCORD_URL=https://questcord.fun

# Discord bot token for posting results — automatically uses CUB_PROTECTOR_TOKEN
# Only set this if you want a different bot to post security results
# SECURITY_BOT_TOKEN=

# Channel ID to post results to (default: 1493106273116356761)
# SECURITY_CHANNEL_ID=1493106273116356761
