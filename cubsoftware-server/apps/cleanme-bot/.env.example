# Discord Bot Token - Get from Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# Discord Application Client ID - Get from Discord Developer Portal
CLIENT_ID=your_client_id_here

# Bot Owner(s) - comma-separated for multiple owners
OWNER_IDS=378501056008683530

# Terminal channel ID (where admins can run commands)
TERMINAL_CHANNEL_ID=1466190746401902855

# CleanMe Website Integration
# URL of the CleanMe website (no trailing slash)
CLEANME_WEBSITE_URL=https://cubsoftware.site
# API key for the CleanMe website (must match CLEANME_BOT_API_KEY or ADMIN_API_KEY on the server)
CLEANME_API_KEY=your_admin_api_key_here
