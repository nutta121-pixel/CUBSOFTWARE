# ── Discord Bot ────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
OWNER_IDS=                          # Comma-separated Discord user IDs

# ── Server / Guild IDs ─────────────────────────────────────────
ADMIN_GUILD_ID=                     # Guild ID where admin commands are restricted to
DEV_GUILD_ID=                       # Guild ID for dev/test slash command registration

# ── Channel IDs ────────────────────────────────────────────────
TERMINAL_CHANNEL_ID=                # Discord channel for bot terminal output
LINKS_LOG_CHANNEL_ID=               # Discord channel to log detected links

# ── Website API ────────────────────────────────────────────────
API_URL=https://cubsoftware.site    # Base URL of the cubsoftware website
API_KEY=                            # Shared secret between bot and website (BOT_API_KEY)

# ── Ports ──────────────────────────────────────────────────────
LOG_SERVER_PORT=3847                # Port for the bot's internal log HTTP server
CUBREACTIVE_WS_PORT=8765            # WebSocket port for CubReactive overlay

# ── Twitch ─────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── YouTube ────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── AI (CubAI) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CUBAI_TRIGGER=cub                   # Keyword that triggers CubAI in chat
WHISPER_MODEL=base                  # Whisper model size: tiny, base, small, medium, large
