# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
SUPPORT_SERVER_ID=1284593395188367502

# Bot Owner(s) - comma-separated for multiple owners
OWNER_IDS=378501056008683530

# Terminal channel ID (where admins can run commands)
TERMINAL_CHANNEL_ID=1466190431485427856

# Web Server
# Generate a new secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# Production Settings
NODE_ENV=development

# OAuth Callback URLs
# Development: http://localhost:3000/auth/discord/callback
# Production: https://questcord.fun/auth/discord/callback
