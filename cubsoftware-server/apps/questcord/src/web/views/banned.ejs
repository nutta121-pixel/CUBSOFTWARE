<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied | QuestCord</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            max-width: 620px;
            width: 100%;
        }

        .header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .ban-icon {
            font-size: 72px;
            display: block;
            margin-bottom: 1rem;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }

        h1 {
            font-size: 2.2rem;
            color: #ed4245;
            margin-bottom: 0.4rem;
        }

        .subtitle {
            color: #b9bbbe;
            font-size: 1rem;
        }

        .card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
        }

        .card.danger {
            border-color: rgba(237,66,69,0.35);
            background: rgba(237,66,69,0.06);
        }

        .card-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: #72767d;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.75rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            gap: 1rem;
        }

        .info-row:last-child { border-bottom: none; }

        .info-label { color: #b9bbbe; font-size: 0.88rem; font-weight: 500; flex-shrink: 0; }
        .info-value {
            color: #fff;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.88rem;
            text-align: right;
            word-break: break-all;
        }
        .info-value.red { color: #ed4245; font-weight: 600; }

        /* Countdown */
        .countdown-grid {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            margin-top: 0.75rem;
        }

        .cd-unit { text-align: center; min-width: 56px; }

        .cd-num {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.8rem;
            font-weight: 700;
            background: rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 0.4rem 0.5rem;
            line-height: 1;
        }

        .cd-label {
            font-size: 0.65rem;
            color: #72767d;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-top: 0.3rem;
        }

        .cd-sep {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.6rem;
            color: #72767d;
            align-self: center;
            padding-bottom: 1.4rem;
        }

        .expired-notice {
            text-align: center;
            color: #57f287;
            font-size: 0.9rem;
            margin-top: 0.5rem;
            display: none;
        }

        /* Probes */
        .probes-list {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            max-height: 160px;
            overflow-y: auto;
            margin-top: 0.5rem;
        }

        .probe-path {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.78rem;
            color: #faa61a;
            background: rgba(250,166,26,0.07);
            border: 1px solid rgba(250,166,26,0.18);
            border-radius: 5px;
            padding: 0.25rem 0.5rem;
        }

        /* Reason box */
        .reason-box {
            background: rgba(0,0,0,0.25);
            border-radius: 8px;
            padding: 0.875rem 1rem;
            color: #faa61a;
            font-size: 0.9rem;
            font-style: italic;
        }

        /* Appeal button */
        .appeal-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.85rem;
            background: rgba(88,101,242,0.1);
            border: 1px solid rgba(88,101,242,0.3);
            border-radius: 10px;
            color: #7289da;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            transition: background 0.2s, border-color 0.2s;
            margin-bottom: 1rem;
        }

        .appeal-btn:hover {
            background: rgba(88,101,242,0.2);
            border-color: rgba(88,101,242,0.6);
            color: #fff;
        }

        .contact {
            text-align: center;
            color: #72767d;
            font-size: 0.88rem;
        }

        .contact a { color: #5865f2; text-decoration: none; font-weight: 600; }
        .contact a:hover { text-decoration: underline; }

        @media (max-width: 500px) {
            h1 { font-size: 1.6rem; }
            .cd-num { font-size: 1.3rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <span class="ban-icon">🚫</span>
            <h1>Access Denied</h1>
            <p class="subtitle">Your IP address has been banned from accessing QuestCord.</p>
        </div>

        <div class="card danger">
            <div class="card-label">Ban Details</div>
            <div class="info-row">
                <span class="info-label">IP Address</span>
                <span class="info-value red"><%= banInfo.ip_address %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Banned By</span>
                <span class="info-value"><%= banInfo.banned_by %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Banned At</span>
                <span class="info-value" id="banned-at-val"><%= new Date(banInfo.banned_at * 1000).toLocaleString() %></span>
            </div>
            <% if (banInfo.permanent) { %>
            <div class="info-row">
                <span class="info-label">Duration</span>
                <span class="info-value">Permanent</span>
            </div>
            <% } else { %>
            <div class="info-row">
                <span class="info-label">Expires At</span>
                <span class="info-value" id="expires-at-val">—</span>
            </div>
            <% } %>
        </div>

        <div class="card">
            <div class="card-label">Reason</div>
            <div class="reason-box"><%= banInfo.reason %></div>
        </div>

        <% if (!banInfo.permanent && expiresTs) { %>
        <div class="card">
            <div class="card-label" style="text-align:center;">Time Until Unbanned</div>
            <div class="countdown-grid" id="countdown-grid">
                <div class="cd-unit"><span class="cd-num" id="cd-d">--</span><div class="cd-label">Days</div></div>
                <div class="cd-sep">:</div>
                <div class="cd-unit"><span class="cd-num" id="cd-h">--</span><div class="cd-label">Hours</div></div>
                <div class="cd-sep">:</div>
                <div class="cd-unit"><span class="cd-num" id="cd-m">--</span><div class="cd-label">Mins</div></div>
                <div class="cd-sep">:</div>
                <div class="cd-unit"><span class="cd-num" id="cd-s">--</span><div class="cd-label">Secs</div></div>
            </div>
            <div class="expired-notice" id="expired-notice">Your ban may have expired — try refreshing.</div>
        </div>
        <% } %>

        <% if (probes && probes.length > 0) { %>
        <div class="card">
            <div class="card-label">Detected Probe Paths (<%= probes.length %>)</div>
            <div class="probes-list">
                <% probes.forEach(function(p) { %>
                <div class="probe-path"><%= p %></div>
                <% }); %>
            </div>
        </div>
        <% } %>

        <a href="/ip-ban-appeal?ip=<%= banInfo.ip_address %>" class="appeal-btn">
            📋 Submit a Ban Appeal
        </a>

        <div class="contact">
            <p>Or contact us on our <a href="https://discord.gg/ACGKvKkZ5Z" target="_blank">Discord Support Server</a></p>
        </div>
    </div>

    <% if (!banInfo.permanent && expiresTs) { %>
    <script>
        const expiresTs = <%= expiresTs %>;

        function pad(n) { return String(n).padStart(2, '0'); }

        const expiresOnEl = document.getElementById('expires-at-val');
        if (expiresOnEl) expiresOnEl.textContent = new Date(expiresTs * 1000).toLocaleString();

        function tick() {
            const remaining = expiresTs - Math.floor(Date.now() / 1000);
            if (remaining <= 0) {
                document.getElementById('countdown-grid').style.display = 'none';
                document.getElementById('expired-notice').style.display = 'block';
                return;
            }
            const d = Math.floor(remaining / 86400);
            const h = Math.floor((remaining % 86400) / 3600);
            const m = Math.floor((remaining % 3600) / 60);
            const s = remaining % 60;
            document.getElementById('cd-d').textContent = pad(d);
            document.getElementById('cd-h').textContent = pad(h);
            document.getElementById('cd-m').textContent = pad(m);
            document.getElementById('cd-s').textContent = pad(s);
        }
        tick();
        setInterval(tick, 1000);
    </script>
    <% } %>
</body>
</html>
